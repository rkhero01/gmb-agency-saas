# Backend Server Configuration
PORT=5000
NODE_ENV=development
APP_NAME=gmb-agency-saas-api
API_PREFIX=/api/v1

# Security & CORS
CORS_ORIGIN=http://localhost:5173

# Database Connection (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gmb_agency_saas_dev
DB_USER=postgres
DB_PASSWORD=your_secure_postgres_password_here
DB_SSL=false
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONN_TIMEOUT_MS=3000
# Optional full connection string:
# DATABASE_URL=postgresql://postgres:your_secure_postgres_password_here@localhost:5432/gmb_agency_saas_dev

# JWT Secret (Phase 2+)
JWT_SECRET=your_jwt_secret_placeholder_at_least_32_characters_long

# Google Cloud OAuth 2.0 Credentials (Phase 4)
# Create OAuth 2.0 Web Application credentials in Google Cloud Console
# Ensure Authorized Redirect URIs include GOOGLE_REDIRECT_URI
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/google/callback
