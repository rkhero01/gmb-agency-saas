{
  "name": "gmb-agency-saas",
  "version": "0.1.0",
  "description": "Production-ready multi-tenant SaaS for marketing agencies managing Google Business Profiles",
  "private": true,
  "scripts": {
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "start:backend": "npm --prefix backend start",
    "start:frontend": "npm --prefix frontend run preview",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "test": "npm --prefix backend test",
    "test:tenant": "npm --prefix backend run test:tenant",
    "test:migrator": "npm --prefix backend run test:migrator",
    "db:migrate": "npm --prefix backend run db:migrate",
    "db:status": "npm --prefix backend run db:status"
  },
  "keywords": [
    "gmb",
    "google-business-profile",
    "agency-saas",
    "multi-tenant",
    "local-seo"
  ],
  "author": "",
  "license": "UNLICENSED"
}
