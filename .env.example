# ==============================================================================
# GMB Agency SaaS - Global Environment Configuration Template
# NOTE: Never commit actual secret keys or credentials to version control.
# Copy this file to .env or use service-specific .env files in backend/ and frontend/.
# ==============================================================================

# Server Configuration
NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000

# Client Configuration
FRONTEND_PORT=5173
FRONTEND_URL=http://localhost:5173

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gmb_agency_saas_dev
DB_USER=postgres
DB_PASSWORD=your_secure_postgres_password_here
DB_SSL=false
DATABASE_URL=postgresql://postgres:your_secure_postgres_password_here@localhost:5432/gmb_agency_saas_dev

# JWT & Authentication Secret (Future Phase)
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters_here
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (Comma-separated)
CORS_ORIGIN=http://localhost:5173

# Future Google Cloud / Google Business Profile API Credentials (Placeholder only)
# GOOGLE_CLIENT_ID=your_google_client_id_placeholder.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your_google_client_secret_placeholder
# GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/auth/google/callback
